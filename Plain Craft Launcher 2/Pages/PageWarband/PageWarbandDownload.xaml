<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageWarbandDownload"
    PanScroll="PanBack" d:DesignWidth="800" d:DesignHeight="900">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10">

            <local:MyCard Title="模组下载" Margin="0,15">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush3}"
                               Text="这里集中放战团 mod 的下载入口：每个条目都能一键跳到「骑砍中文站」站内搜索，也可以自己填网盘链接与提取码（保存在本机 mods.json，不会上传）。" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <local:MyTextBox x:Name="TextSearch" Width="240" Height="28" ToolTip="按名称过滤下面的列表" />
                        <local:MyButton x:Name="BtnRefresh" Text="刷新列表" Height="28" Padding="13,5" Margin="10,0,0,0" />
                        <local:MyButton x:Name="BtnOpenData" Text="打开数据文件" Height="28" Padding="13,5" Margin="8,0,0,0" />
                        <local:MyButton x:Name="BtnChineseSite" Text="打开骑砍中文站" Height="28" Padding="13,5" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="PanEntries" Margin="0,16,0,0" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Title="填写 / 修改网盘地址" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock x:Name="LabEditing" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush3}"
                               Text="在下面的列表里点某个条目的「填写网盘」，这里就会切换到那一条。" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="网盘链接" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <local:MyTextBox x:Name="TextPanUrl" Grid.Row="0" Grid.Column="1" Height="28" Margin="0,0,0,10"
                                         ToolTip="例如 https://pan.baidu.com/s/xxxx 或 https://www.123pan.com/s/xxxx" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="提取码" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <local:MyTextBox x:Name="TextPanCode" Grid.Row="1" Grid.Column="1" Height="28" Width="160" HorizontalAlignment="Left" Margin="0,0,0,10" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <local:MyButton x:Name="BtnSaveEntry" Text="保存到本机" ColorType="Highlight" Height="30" MinWidth="140" Padding="14,5" />
                            <TextBlock x:Name="LabSaveStatus" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource ColorBrush3}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ColorBrush3}" Margin="4,0,4,20"
                       Text="说明：本页只提供链接跳转，不托管也不转存任何文件；网盘链接默认留空，请自行填写并注意来源与版权。界面与设置体系来自 PCL2（© 龙腾猫跃），本作是基于 PCL 的第三方修改版。" />
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
