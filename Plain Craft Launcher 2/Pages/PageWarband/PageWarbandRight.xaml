<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageWarbandRight"
    PanScroll="PanBack" d:DesignWidth="800" d:DesignHeight="900">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10">

<local:MyCard Title="游戏环境" Margin="0,15">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TextGamePath" Grid.Column="0" Height="28"
                                         ToolTip="Mount &amp; Blade Warband 安装目录（含 mb_warband_wse2.exe）" />
                        <local:MyButton x:Name="BtnDetect" Grid.Column="1" Text="自动检测" Height="28" Padding="13,5" Margin="10,0,0,0" />
                        <local:MyButton x:Name="BtnBrowse" Grid.Column="2" Text="浏览…" Height="28" Padding="13,5" Margin="8,0,0,0" />
                        <local:MyButton x:Name="BtnApplyPath" Grid.Column="3" Text="加载" Height="28" Padding="13,5" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="LabGameStatus" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrush3}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabWse2Status" Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{DynamicResource ColorBrush3}" />
                        <local:MyButton x:Name="BtnInstallWse2" Grid.Column="1" Text="一键安装 WSE2" ColorType="Highlight"
                                        Height="30" Padding="14,5" Margin="10,0,0,0" />
                        <local:MyButton x:Name="BtnInstallWse2Zip" Grid.Column="2" Text="从 zip 安装…"
                                        Height="30" Padding="14,5" Margin="8,0,0,0" />
                        <local:MyButton x:Name="BtnWse2Official" Grid.Column="3" Text="WSE2 官方页"
                                        Height="30" Padding="14,5" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Title="启动设置" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="模块" VerticalAlignment="Center" Width="70" />
                        <local:MyComboBox x:Name="ComboModule" Width="360" Height="28" />
                        <local:MyButton x:Name="BtnRefreshModules" Text="刷新" Height="28" Padding="13,5" Margin="10,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <TextBlock Text="运行时" VerticalAlignment="Center" Width="70" />
                        <local:MyRadioButton x:Name="RadioX86" Text="32 位（x86）" Tag="0" ColorType="Highlight" Margin="0,0,14,0" />
                        <local:MyRadioButton x:Name="RadioX64" Text="64 位（x64）" Tag="1" ColorType="Highlight" />
                        <TextBlock x:Name="LabRuntimeHint" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource ColorBrush3}"
                                   Text="与 WSE2 官方启动器一致的两档；大型 mod 请用 x64（32 位只有 2GB 地址空间）。" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <TextBlock Text="附加" VerticalAlignment="Center" Width="70" />
                        <local:MyCheckBox x:Name="CheckNoIntro" Text="跳过开场动画" VerticalAlignment="Center" />
                        <local:MyTextBox x:Name="TextExtraArgs" Width="360" Height="28" Margin="20,0,0,0"
                                         ToolTip="额外命令行参数，例如：--address 1.2.3.4:7240 --password 1234" />
                    </StackPanel>

                    <Border Background="{DynamicResource ColorBrushSemiTransparent}" CornerRadius="4" Padding="10,8" Margin="0,15,0,0">
                        <TextBlock x:Name="LabCommand" TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei UI"
                                   Foreground="{DynamicResource ColorBrush3}" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <local:MyButton x:Name="BtnLaunch" Text="启动游戏" ColorType="Highlight" Height="36" MinWidth="160" Padding="18,6" />
                        <local:MyButton x:Name="BtnStop" Text="结束进程" Height="36" MinWidth="110" Padding="14,6" Margin="10,0,0,0" />
                        <TextBlock x:Name="LabStatus" VerticalAlignment="Center" Margin="18,0,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrush3}" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Title="启动前体检与崩溃速诊" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <local:MyButton x:Name="BtnRecheck" Text="重新体检" Height="28" Padding="13,5" />
                        <local:MyButton x:Name="BtnDiagnose" Text="崩溃速诊" Height="28" Padding="13,5" Margin="8,0,0,0" />
                        <local:MyButton x:Name="BtnRefreshLog" Text="刷新日志" Height="28" Padding="13,5" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="PanChecks" />
                    <Border Background="{DynamicResource ColorBrushSemiTransparent}" CornerRadius="4" Padding="12,10" Margin="0,10,0,0">
                        <TextBlock x:Name="LabDiagnosis" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush3}"
                                   Text="尚未运行崩溃速诊。" />
                    </Border>
                    <local:MyScrollViewer Height="170" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <TextBlock x:Name="LabLog" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                   TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush3}" />
                    </local:MyScrollViewer>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Title="WSE2 性能配置（rgl_config.ini）" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <local:MyButton x:Name="BtnPresetLow" Text="低配预设" Height="28" Padding="13,5" Tag="low" />
                        <local:MyButton x:Name="BtnPresetMid" Text="均衡预设" Height="28" Padding="13,5" Margin="8,0,0,0" Tag="mid" />
                        <local:MyButton x:Name="BtnPresetHigh" Text="高画质预设" Height="28" Padding="13,5" Margin="8,0,0,0" Tag="high" />
                        <local:MyButton x:Name="BtnOpenConfigDir" Text="打开配置目录" Height="28" Padding="13,5" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="PanKnobs" />
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <local:MyButton x:Name="BtnSaveConfig" Text="保存到 rgl_config.ini" ColorType="Highlight" Height="32" MinWidth="180" Padding="16,5" />
                        <TextBlock x:Name="LabConfigStatus" VerticalAlignment="Center" Margin="15,0,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrush3}" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
