<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PCL2 上游用的是 VS2015+ 的老式 vbproj（需 Visual Studio / WPF targets）。
    这里换成 SDK 风格：同样的源码、同样的 net48 + WPF，但只用 .NET SDK 就能编译
    （参考程序集由 Microsoft.NETFramework.ReferenceAssemblies 提供）。
    原文件保留为 Plain Craft Launcher 2.vbproj.legacy 以便对照。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PCL</RootNamespace>
    <AssemblyName>Plain Craft Launcher 2</AssemblyName>
    <MyType>Custom</MyType>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <StartupObject>PCL.Application</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Images\icon.ico</ApplicationIcon>
    <Configurations>Debug;Release;Snapshot</Configurations>
    <Deterministic>true</Deterministic>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Product>PCL 战团版 (PCL Warband)</Product>
    <AssemblyTitle>PCL 战团版</AssemblyTitle>
    <Company>第三方基于 PCL 的二次创作</Company>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>SNAPSHOT</DefineConstants>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- 上游项目级 Imports（老式 vbproj 写在 Project 里，SDK 风格用 Import 项） -->
  <ItemGroup>
    <Import Include="MeloongCore" />
    <Import Include="MeloongCore.Extensions" />
    <Import Include="MeloongCore.Wpf" />
    <Import Include="MeloongCore.Wpf.Extensions" />
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="Newtonsoft.Json" />
    <Import Include="Newtonsoft.Json.Linq" />
    <Import Include="PCLCS" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Concurrent" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.IO" />
    <Import Include="System.IO.Compression" />
    <Import Include="System.Linq" />
    <Import Include="System.Net" />
    <Import Include="System.Net.Http" />
    <Import Include="System.Text" />
    <Import Include="System.Threading" />
    <Import Include="System.Threading.Tasks" />
    <Import Include="System.Windows" />
    <Import Include="System.Windows.Controls" />
    <Import Include="System.Windows.Data" />
    <Import Include="System.Windows.Documents" />
    <Import Include="System.Windows.Input" />
    <Import Include="System.Windows.Media" />
    <Import Include="System.Windows.Media.Imaging" />
    <Import Include="System.Xml.Linq" />
    <Import Include="ThrottleDebounce" />
  </ItemGroup>

  <!-- 上游把第三方依赖以 DLL 形式放在 Resources\ 下 -->
  <ItemGroup>
    <Reference Include="CacheCow.Client">
      <HintPath>Resources\CacheCow.Client.dll</HintPath>
    </Reference>
    <Reference Include="CacheCow.Client.FileStore">
      <HintPath>Resources\CacheCow.Client.FileStore.dll</HintPath>
    </Reference>
    <Reference Include="CacheCow.Common">
      <HintPath>Resources\CacheCow.Common.dll</HintPath>
    </Reference>
    <Reference Include="Imazen.WebP">
      <HintPath>Resources\Imazen.WebP.dll</HintPath>
    </Reference>
    <Reference Include="NAudio">
      <HintPath>Resources\NAudio.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>Resources\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="Ookii.Dialogs.Wpf">
      <HintPath>Resources\Ookii.Dialogs.Wpf.dll</HintPath>
    </Reference>
    <Reference Include="System.Net.Http.Formatting">
      <HintPath>Resources\System.Net.Http.Formatting.dll</HintPath>
    </Reference>
    <Reference Include="ThrottleDebounce">
      <HintPath>Resources\ThrottleDebounce.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Runtime.Caching" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeloongCore\Shared\MeloongCore.csproj" />
    <ProjectReference Include="..\MeloongCore\Wpf\MeloongCore.Wpf.csproj" />
    <ProjectReference Include="..\PCLCS\PCLCS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="My Project\Resources.resx">
      <LogicalName>PCL.Resources.resources</LogicalName>
    </EmbeddedResource>
    <!-- SDK 风格用 MyType 自行生成；这里保留上游的 Designer 文件，避免两套定义冲突 -->
    <Compile Remove="My Project\Settings.Designer.vb" />
    <None Remove="My Project\Settings.settings" />
    <None Remove="My Project\app.manifest" />
    <None Remove="Plain Craft Launcher 2.vbproj.legacy" />
    <!-- Resources\Custom.xaml 是运行时读取的模板文本，不是 WPF 页面 -->
    <Page Remove="Resources\Custom.xaml" />
    <None Include="Resources\Custom.xaml" />
    <!-- MySliderDot 在上游仓库里存在但未纳入编译（老项目 Compile 清单里没有），这里同样排除 -->
    <Compile Remove="Controls\MySliderDot.xaml.vb" />
    <Page Remove="Controls\MySliderDot.xaml" />
  </ItemGroup>


  <!-- 上游的 WPF Resource / 运行时数据文件（SDK 风格不会自动收集） -->
  <ItemGroup>
    <Resource Include="Images\icon.ico" />
    <Resource Include="Resources\Font.ttf" />
    <Resource Include="Images\Heads\LTCat.jpg" />
    <Resource Include="Images\Blocks\Anvil.png" />
    <Resource Include="Images\Blocks\CobbleStone.png" />
    <Resource Include="Images\Blocks\CommandBlock.png" />
    <Resource Include="Images\Blocks\Grass.png" />
    <Resource Include="Images\Blocks\RedstoneBlock.png" />
    <Resource Include="Images\Blocks\GrassPath.png" />
    <Resource Include="Images\Blocks\Egg.png" />
    <Resource Include="Images\Heads\Hao_Tian.jpg" />
    <Resource Include="Images\Skins\Steve.png" />
    <Resource Include="Images\Skins\Alex.png" />
    <Resource Include="Images\Themes\5.png" />
    <Resource Include="Images\Themes\6.png" />
    <Resource Include="Images\Themes\7.png" />
    <Resource Include="Images\Themes\8.png" />
    <Resource Include="Images\Themes\9.png" />
    <Resource Include="Images\Themes\10.png" />
    <Resource Include="Images\Heads\Patrick.png" />
    <Resource Include="Images\Themes\11.png" />
    <Resource Include="Images\Themes\12.png" />
    <Resource Include="Images\Blocks\GoldBlock.png" />
    <Resource Include="Images\Themes\13.png" />
    <Resource Include="Images\Themes\42.png" />
    <Resource Include="Images\Blocks\RedstoneLampOff.png" />
    <Resource Include="Images\Blocks\RedstoneLampOn.png" />
    <Resource Include="Images\Blocks\Fabric.png" />
    <Resource Include="Images\Heads\Logo.png" />
    <Resource Include="Images\ReleaseTypes\Alpha.png" />
    <Resource Include="Images\ReleaseTypes\Beta.png" />
    <Resource Include="Images\ReleaseTypes\Release.png" />
    <Resource Include="Images\Icons\NoIcon.png" />
    <Resource Include="Images\Heads\PCL2.png" />
    <Resource Include="Images\Heads\00ll00.png" />
    <Resource Include="Images\Heads\bangbang93.png" />
    <Resource Include="Images\Heads\wiki.png" />
    <Resource Include="Images\Blocks\OptiFabric.png" />
    <Resource Include="Images\Skins\Ari.png" />
    <Resource Include="Images\Skins\Efe.png" />
    <Resource Include="Images\Skins\Kai.png" />
    <Resource Include="Images\Skins\Makena.png" />
    <Resource Include="Images\Skins\Noor.png" />
    <Resource Include="Images\Skins\Sunny.png" />
    <Resource Include="Images\Skins\Zuri.png" />
    <Resource Include="Images\Icons\Disabled.png" />
    <Resource Include="Images\Heads\MCBBS.png" />
    <Resource Include="Images\Blocks\NeoForge.png" />
    <Resource Include="Images\Heads\z0z0r4.png" />
    <Resource Include="Images\Heads\EasyTier.png" />
    <Resource Include="Images\Heads\ChongQing.png" />
    <Resource Include="Images\Heads\HerobrineXia.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\Custom.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="App.config" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\Help.zip" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\NAudio.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\Newtonsoft.Json.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\Ookii.Dialogs.Wpf.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\forge-installer.jar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\transformer.jar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\Imazen.WebP.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\libwebp64.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\CacheCow.Client.FileStore.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\CacheCow.Common.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\CacheCow.Client.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\ThrottleDebounce.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\System.Net.Http.Formatting.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PCLCS\bin\PCLCS.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PCLCS\bin\MeloongCore.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PCLCS\bin\MeloongCore.Wpf.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PCLCS\bin\Microsoft.Win32.Registry.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
